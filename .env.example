# Copy this file to .env (git-ignored) and fill in your own key. Never commit .env.
# Get a key from Google AI Studio. Free-tier prompts may be used to improve Google products,
# so use synthetic data only while on the free tier.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   (default; tried first, then 3.5-flash and 2.5-flash if it is slow or overloaded)

# Optional: a different hotkey (Electron accelerator syntax)
# HOTKEY=Control+Shift+Space

# Optional: make the live Rovo connection refuse all writes
# ROVO_READONLY=1

# Optional: Microsoft 365 (Outlook, calendar, To Do, Teams) through Softeria's ms-365-mcp-server.
# Usually you connect with /connect in the window instead; these settings override what it remembers.
# M365=1
# M365_WORK=1            # work or school account: adds Teams and people lookups
# M365_TENANT_ID=consumers   # for a personal Microsoft account (otherwise sessions drop after about an hour)
# M365_CLIENT_ID=        # your own Entra app registration (default: the server's built-in app)
# M365_READONLY=1        # refuse every write
# M365_TIME_ZONE=Asia/Kolkata   # zone for meeting times (default: this machine's)
