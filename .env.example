# Copy this file to .env (git-ignored) and fill in your own key. Never commit .env.
# Get a key from Google AI Studio. Free-tier prompts may be used to improve Google products,
# so use synthetic data only while on the free tier.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   (default; tried first, then 3.5-flash and 2.5-flash if it is slow or overloaded)

# Optional: a different hotkey (Electron accelerator syntax)
# HOTKEY=Control+Shift+Space

# Optional: make the live Rovo connection refuse all writes
# ROVO_READONLY=1
